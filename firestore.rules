rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    function isActive() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/users/$(request.auth.uid)
        )
        && profile().is_active == true;
    }

    function hasRole(roleName) {
      return isActive()
        && profile().role == roleName;
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isEditor() {
      return hasRole('editor');
    }

    function isReviewer() {
      return hasRole('reviewer');
    }

    function hasAssignableRole() {
      return request.resource.data.role in ['admin', 'editor', 'reviewer', 'viewer'];
    }

    function canEditOwnedContent(contentId) {
      let content = getAfter(
        /databases/$(database)/documents/contents/$(contentId)
      ).data;

      return isEditor()
        && content.created_by == request.auth.token.email
        && content.workflow_status in ['draft', 'review'];
    }

    function canReadContent(contentId) {
      let content = get(
        /databases/$(database)/documents/contents/$(contentId)
      ).data;

      return isAdmin()
        || isReviewer()
        || (
          isEditor()
          && content.created_by == request.auth.token.email
        )
        || (
          isActive()
          && content.workflow_status == 'published'
          && content.access_level in ['public', 'internal']
        );
    }

    function validSourceReference(reference) {
      return reference is map
        && reference.keys().hasAll(['source_id', 'relation_type'])
        && reference.keys().hasOnly(['source_id', 'relation_type'])
        && reference.source_id is string
        && reference.source_id.size() >= 12
        && reference.source_id.size() <= 69
        && reference.source_id.matches('^SRC-[A-Za-z0-9_-]+$')
        && reference.relation_type in ['primary', 'supporting'];
    }

    function sourceReferenceAt(data, index) {
      return data.source_references.size() <= index
        || (
          validSourceReference(data.source_references[index])
          && data.source_references[index].source_id == data.source_ids[index]
        );
    }

    function validSourceRelationships(data) {
      let hasReferences = 'source_references' in data;
      let hasIds = 'source_ids' in data;
      return (!hasReferences && !hasIds)
        || (
          hasReferences
          && hasIds
          && data.source_references is list
          && data.source_ids is list
          && data.source_references.size() <= 5
          && data.source_ids.size() <= 5
          && data.source_references.size() == data.source_ids.size()
          && data.source_ids.toSet().size() == data.source_ids.size()
          && sourceReferenceAt(data, 0)
          && sourceReferenceAt(data, 1)
          && sourceReferenceAt(data, 2)
          && sourceReferenceAt(data, 3)
          && sourceReferenceAt(data, 4)
        );
    }

    function validSourceDocument(sourceId, data, expectedCreator) {
      return data.keys().hasAll([
          'source_id', 'source_type', 'title', 'reference_no', 'document_date',
          'issuing_authority', 'official_url', 'description', 'access_level',
          'created_by', 'created_at', 'updated_at'
        ])
        && data.keys().hasOnly([
          'source_id', 'source_type', 'title', 'reference_no', 'document_date',
          'issuing_authority', 'official_url', 'description', 'access_level',
          'created_by', 'created_at', 'updated_at'
        ])
        && data.source_id == sourceId
        && sourceId.size() >= 12
        && sourceId.size() <= 69
        && sourceId.matches('^SRC-[A-Za-z0-9_-]+$')
        && data.source_type in ['law', 'regulation', 'circular', 'order', 'officialLetter', 'judgment', 'committeeDecision', 'guide', 'other']
        && data.title is string && data.title.size() > 0 && data.title.size() <= 300
        && data.reference_no is string && data.reference_no.size() <= 160
        && data.document_date is string && data.document_date.size() <= 40
        && data.issuing_authority is string && data.issuing_authority.size() <= 200
        && data.official_url is string && data.official_url.size() <= 2048
        && (data.official_url == '' || data.official_url.matches('^https?://[^\\s]+$'))
        && data.description is string && data.description.size() <= 4000
        && data.access_level in ['public', 'internal', 'restricted']
        && data.created_by is string && data.created_by == expectedCreator
        && data.created_at is timestamp
        && data.updated_at is timestamp;
    }

    function canReadSource(sourceId) {
      let sourcePath = /databases/$(database)/documents/sources/$(sourceId);
      return isActive()
        && exists(sourcePath)
        && (isAdmin() || isReviewer()
          || (isEditor() && (get(sourcePath).data.access_level in ['public', 'internal']
            || get(sourcePath).data.created_by == request.auth.token.email)));
    }

    function validIngestion(sourceId, ingestionId, data) {
      let canonicalSource = get(/databases/$(database)/documents/sources/$(sourceId)).data;
      return data.keys().hasAll(['ingestion_id', 'source_id', 'ingestion_method', 'document_label',
          'content_hash', 'normalizer_version', 'segmenter_version', 'extraction_status',
          'source_snapshot', 'created_by', 'created_at', 'updated_at'])
        && data.keys().hasOnly(['ingestion_id', 'source_id', 'ingestion_method', 'document_label',
          'original_url', 'original_filename', 'media_type', 'extractor', 'extractor_version',
          'content_hash', 'normalizer_version', 'segmenter_version', 'extraction_status',
          'source_snapshot', 'created_by', 'created_at', 'updated_at'])
        && data.ingestion_id == ingestionId
        && ingestionId.size() >= 8 && ingestionId.size() <= 100
        && data.source_id == sourceId
        && data.ingestion_method in ['text', 'local_file', 'remote_url']
        && data.document_label is string && data.document_label.size() > 0 && data.document_label.size() <= 200
        && (!('original_url' in data) || (data.original_url is string && data.original_url.size() <= 2048
          && data.original_url.matches('^https?://[^\\s]+$')))
        && (
          (data.ingestion_method == 'text'
            && !('original_filename' in data) && !('media_type' in data)
            && !('extractor' in data) && !('extractor_version' in data))
          || (data.ingestion_method == 'local_file'
            && !('original_url' in data)
            && data.keys().hasAll(['original_filename', 'media_type', 'extractor', 'extractor_version'])
            && data.original_filename is string && data.original_filename.size() > 0
            && data.original_filename.size() <= 255
            && !data.original_filename.matches('.*[/\\\\].*')
            && data.media_type in ['text/plain', 'text/markdown', 'application/pdf', 'application/vnd.openxmlformats-officedocument.wordprocessingml.document']
            && data.extractor in ['browser-text', 'pdfjs', 'mammoth']
            && data.extractor_version is string && data.extractor_version.size() > 0
            && data.extractor_version.size() <= 40
            && ((data.media_type in ['text/plain', 'text/markdown'] && data.extractor == 'browser-text')
              || (data.media_type == 'application/pdf' && data.extractor == 'pdfjs')
              || (data.media_type == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document' && data.extractor == 'mammoth')))
          || (data.ingestion_method == 'remote_url'
            && !('original_filename' in data)
            && data.keys().hasAll(['original_url', 'media_type', 'extractor', 'extractor_version'])
            && data.media_type in ['text/plain', 'text/markdown', 'application/pdf', 'application/vnd.openxmlformats-officedocument.wordprocessingml.document']
            && data.extractor in ['browser-text', 'pdfjs', 'mammoth']
            && data.extractor_version is string && data.extractor_version.size() > 0
            && data.extractor_version.size() <= 40
            && ((data.media_type in ['text/plain', 'text/markdown'] && data.extractor == 'browser-text')
              || (data.media_type == 'application/pdf' && data.extractor == 'pdfjs')
              || (data.media_type == 'application/vnd.openxmlformats-officedocument.wordprocessingml.document' && data.extractor == 'mammoth')))
        )
        && data.content_hash is string && data.content_hash.matches('^[a-f0-9]{64}$')
        && data.normalizer_version is string && data.normalizer_version.size() <= 40
        && data.segmenter_version is string && data.segmenter_version.size() <= 40
        && data.extraction_status in ['completed', 'failed']
        && data.source_snapshot is map
        && data.source_snapshot.keys().hasOnly(['source_type', 'title', 'reference_no', 'document_date', 'issuing_authority', 'official_url'])
        && data.source_snapshot.keys().hasAll(['source_type', 'title'])
        && data.source_snapshot.source_type is string && data.source_snapshot.source_type.size() <= 40
        && data.source_snapshot.title is string && data.source_snapshot.title.size() <= 300
        && data.source_snapshot.source_type == canonicalSource.source_type
        && data.source_snapshot.title == canonicalSource.title
        && (!('reference_no' in data.source_snapshot) || (data.source_snapshot.reference_no is string && data.source_snapshot.reference_no.size() <= 160))
        && (!('document_date' in data.source_snapshot) || (data.source_snapshot.document_date is string && data.source_snapshot.document_date.size() <= 40))
        && (!('issuing_authority' in data.source_snapshot) || (data.source_snapshot.issuing_authority is string && data.source_snapshot.issuing_authority.size() <= 200))
        && (!('official_url' in data.source_snapshot) || (data.source_snapshot.official_url is string && data.source_snapshot.official_url.size() <= 2048
          && (data.source_snapshot.official_url == '' || data.source_snapshot.official_url.matches('^https?://[^\\s]+$'))))
        && (!('reference_no' in data.source_snapshot) || data.source_snapshot.reference_no == canonicalSource.reference_no)
        && (!('document_date' in data.source_snapshot) || data.source_snapshot.document_date == canonicalSource.document_date)
        && (!('issuing_authority' in data.source_snapshot) || data.source_snapshot.issuing_authority == canonicalSource.issuing_authority)
        && (!('official_url' in data.source_snapshot) || data.source_snapshot.official_url == canonicalSource.official_url)
        && data.created_by is string && data.created_by == request.auth.token.email
        && data.created_at is timestamp && data.updated_at is timestamp;
    }

    function validEvidence(sourceId, ingestionId, evidenceId, data) {
      return data.keys().hasAll(['evidence_id', 'source_id', 'ingestion_id', 'sequence', 'text', 'text_hash', 'review_status', 'created_at'])
        && data.keys().hasOnly(['evidence_id', 'source_id', 'ingestion_id', 'sequence', 'heading', 'locator', 'text', 'text_hash', 'review_status', 'reviewed_by', 'reviewed_at', 'created_at'])
        && data.evidence_id == evidenceId && evidenceId.size() >= 8 && evidenceId.size() <= 100
        && data.source_id == sourceId && data.ingestion_id == ingestionId
        && data.sequence is int && data.sequence >= 0 && data.sequence < 100
        && (!('heading' in data) || (data.heading is string && data.heading.size() <= 500))
        && (!('locator' in data) || (data.locator is string && data.locator.size() <= 500))
        && data.text is string && data.text.size() > 0 && data.text.size() <= 8000
        && data.text_hash is string && data.text_hash.matches('^[a-f0-9]{64}$')
        && data.review_status == 'extracted'
        && !('reviewed_by' in data) && !('reviewed_at' in data)
        && data.created_at is timestamp;
    }

    function mayIngestSource(sourceId) {
      let sourcePath = /databases/$(database)/documents/sources/$(sourceId);
      return isActive()
        && exists(sourcePath)
        && (isAdmin() || (isEditor()
          && (get(sourcePath).data.access_level in ['public', 'internal']
            || get(sourcePath).data.created_by == request.auth.token.email)));
    }

    match /sources/{sourceId} {
      allow get, list: if isAdmin()
        || isReviewer()
        || (isEditor() && (
          resource.data.access_level in ['public', 'internal']
          || resource.data.created_by == request.auth.token.email
        ))
        || (isActive() && resource.data.access_level in ['public', 'internal']);

      allow create: if (
          isAdmin()
          && validSourceDocument(sourceId, request.resource.data, request.auth.token.email)
        ) || (
          isEditor()
          && request.resource.data.access_level == 'restricted'
          && validSourceDocument(sourceId, request.resource.data, request.auth.token.email)
        );

      allow update: if isAdmin()
        && validSourceDocument(sourceId, request.resource.data, resource.data.created_by)
        && request.resource.data.created_at == resource.data.created_at;

      allow delete: if false;

      match /ingestions/{ingestionId} {
        allow get, list: if canReadSource(sourceId);
        allow create: if mayIngestSource(sourceId)
          && validIngestion(sourceId, ingestionId, request.resource.data);
        allow update, delete: if false;

        match /evidence/{evidenceId} {
          allow get, list: if canReadSource(sourceId);
          allow create: if mayIngestSource(sourceId)
            && exists(/databases/$(database)/documents/sources/$(sourceId)/ingestions/$(ingestionId))
            && get(/databases/$(database)/documents/sources/$(sourceId)/ingestions/$(ingestionId)).data.extraction_status == 'completed'
            && validEvidence(sourceId, ingestionId, evidenceId, request.resource.data);
          allow update: if canReadSource(sourceId)
            && (isReviewer() || isAdmin())
            && resource.data.review_status == 'extracted'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['review_status', 'reviewed_by', 'reviewed_at'])
            && request.resource.data.review_status == 'reviewed'
            && request.resource.data.reviewed_by == request.auth.token.email
            && request.resource.data.reviewed_at is timestamp;
          allow delete: if false;
        }
      }
    }

    // ข้อมูลผู้ใช้งาน
    match /users/{userId} {
      allow read: if isActive()
        && (
          request.auth.uid == userId
          || isAdmin()
        );

      allow create, update: if isAdmin() && hasAssignableRole();
      allow delete: if isAdmin();
    }

    // หมวดหมู่
    match /categories/{documentId} {
      allow read: if isActive();

      allow create, update, delete: if isAdmin();
    }

    // เนื้อหาหลักและ Workflow
    match /contents/{documentId} {
      // การเปิดเอกสารรายชิ้นตรวจสิทธิจากเอกสารเป้าหมายได้โดยตรง
      allow get: if canReadContent(documentId);

      // Collection Query ต้องใช้ resource.data เพื่อให้ Rules ตรวจสอบ
      // เงื่อนไข where ของ Query ได้ โดยไม่เรียก get() กลับมายังเอกสารเดิม
      allow list: if isAdmin()
        || isReviewer()
        || (
          isEditor()
          && resource.data.created_by == request.auth.token.email
        )
        || (
          isActive()
          && resource.data.workflow_status == 'published'
          && resource.data.access_level in ['public', 'internal']
        );

      allow create: if validSourceRelationships(request.resource.data)
        && (isAdmin()
        || (
          isEditor()
          && request.resource.data.created_by
            == request.auth.token.email
          && request.resource.data.workflow_status
            in ['draft', 'review']
        ));

      allow update: if validSourceRelationships(request.resource.data)
        && (isAdmin()
        || (
          isEditor()
          && resource.data.created_by
            == request.auth.token.email
          && resource.data.workflow_status
            in ['draft', 'review']
          && request.resource.data.created_by
            == resource.data.created_by
          && request.resource.data.content_id
            == resource.data.content_id
          && request.resource.data.content_type
            == resource.data.content_type
          && request.resource.data.workflow_status
            in ['draft', 'review']
        )
        || (
          isReviewer()
          && resource.data.workflow_status == 'review'
          && request.resource.data.workflow_status == 'approved'
          && request.resource.data.approved_by
            == request.auth.token.email
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly([
              'workflow_status',
              'approved_by',
              'approved_at',
              'updated_at'
            ])));

      allow delete: if isAdmin();
    }

    // ข้อมูลรายละเอียดของเนื้อหา
    match /{collectionName}/{documentId} {
      allow read: if collectionName in [
          'laws',
          'guides',
          'lessons',
          'lessonUnits',
          'files'
        ]
        && canReadContent(resource.data.content_id)
        ;

      allow create: if
        collectionName in [
          'laws',
          'guides',
          'lessons',
          'lessonUnits',
          'files'
        ]
        && (
          isAdmin()
          || canEditOwnedContent(request.resource.data.content_id)
        );

      allow update: if collectionName in [
          'laws',
          'guides',
          'lessons',
          'lessonUnits',
          'files'
        ]
        && (
          isAdmin()
          || (
            canEditOwnedContent(resource.data.content_id)
            && request.resource.data.content_id
              == resource.data.content_id
          )
        );

      allow delete: if isAdmin() && collectionName != 'sources';
    }

    match /questions/{questionId} {
      allow read: if canReadContent(resource.data.content_id);

      allow create: if isAdmin()
        || canEditOwnedContent(request.resource.data.content_id);

      allow update: if isAdmin()
        || (
          canEditOwnedContent(resource.data.content_id)
          && request.resource.data.content_id == resource.data.content_id
        )
        || (
          isReviewer()
          && request.resource.data.accepted_answer_id is string
          && exists(
            /databases/$(database)/documents/answers/$(request.resource.data.accepted_answer_id)
          )
          && getAfter(
            /databases/$(database)/documents/answers/$(request.resource.data.accepted_answer_id)
          ).data.question_id == questionId
          && getAfter(
            /databases/$(database)/documents/answers/$(request.resource.data.accepted_answer_id)
          ).data.is_accepted == true
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['accepted_answer_id', 'updated_at'])
        );

      allow delete: if isAdmin();
    }

    // ความก้าวหน้าการเรียนรายบัญชี
    match /learningProgress/{progressId} {
      allow read: if isActive()
        && (
          isAdmin()
          || resource.data.user_email
            == request.auth.token.email
        );

      allow create: if isActive()
        && (
          isAdmin()
          || request.resource.data.user_email
            == request.auth.token.email
        );

      allow update: if isActive()
        && (
          isAdmin()
          || (
            resource.data.user_email
              == request.auth.token.email
            && request.resource.data.user_email
              == request.auth.token.email
          )
        );

      allow delete: if isAdmin();
    }

    // รายการที่บันทึกไว้รายบัญชี
    match /savedItems/{savedId} {
      allow read: if isActive()
        && (
          isAdmin()
          || resource.data.user_email
            == request.auth.token.email
        );

      allow create: if isActive()
        && request.resource.data.user_email
          == request.auth.token.email;

      allow update: if isActive()
        && resource.data.user_email
          == request.auth.token.email
        && request.resource.data.user_email
          == request.auth.token.email
        && request.resource.data.content_id
          == resource.data.content_id;

      allow delete: if isAdmin()
        || (
          isActive()
          && resource.data.user_email
            == request.auth.token.email
        );
    }

match /comments/{commentId} {
  allow read: if isActive()
    && canReadContent(resource.data.target_id)
    && (
      isAdmin()
      || isReviewer()
      || resource.data.moderation_status == 'approved'
      || resource.data.commented_by
        == request.auth.token.email
    );

  allow create: if isActive()
    && canReadContent(request.resource.data.target_id)
    && request.resource.data.target_type == 'content'
    && request.resource.data.commented_by
      == request.auth.token.email
    && request.resource.data.moderation_status
      == 'pending';

  allow update: if isAdmin()
    || (
      isReviewer()
      && request.resource.data.moderation_status in ['approved', 'rejected']
      && request.resource.data.moderated_by == request.auth.token.email
      && request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['moderation_status', 'moderated_by', 'moderated_at'])
    )
    || (
      isActive()
      && resource.data.commented_by
        == request.auth.token.email
      && resource.data.moderation_status == 'pending'
      && request.resource.data.commented_by
        == resource.data.commented_by
      && request.resource.data.moderation_status
        == 'pending'
      && request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['comment_text', 'updated_at'])
    );

  allow delete: if isAdmin()
    || (
      isActive()
      && resource.data.commented_by
        == request.auth.token.email
    );
}

match /answers/{answerId} {
  allow read: if isActive()
    && canReadContent(resource.data.question_id)
    && (
      isAdmin()
      || isReviewer()
      || resource.data.is_accepted == true
      || resource.data.answered_by == request.auth.token.email
    );

  allow create: if isActive()
    && (
      isAdmin()
      || canReadContent(request.resource.data.question_id)
      || canEditOwnedContent(request.resource.data.question_id)
    )
    && request.resource.data.answered_by
      == request.auth.token.email
    && (
      request.resource.data.is_accepted == false
      || (
        isAdmin()
        && request.resource.data.is_accepted == true
        && request.resource.data.accepted_by == request.auth.token.email
      )
    );

  allow update: if isAdmin()
    || (
      isReviewer()
      && resource.data.is_accepted == false
      && request.resource.data.is_accepted == true
      && request.resource.data.accepted_by == request.auth.token.email
      && request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['is_accepted', 'accepted_by', 'accepted_at'])
    )
    || (
      isActive()
      && resource.data.answered_by
        == request.auth.token.email
      && resource.data.is_accepted == false
      && request.resource.data.answered_by
        == resource.data.answered_by
      && request.resource.data.is_accepted == false
      && request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['answer_text', 'updated_at'])
    );

  allow delete: if isAdmin()
    || (
      isActive()
      && resource.data.answered_by
        == request.auth.token.email
      && resource.data.is_accepted == false
    );
}

// ชุดองค์ความรู้งานทะเบียนที่ดิน
match /knowledgePackages/{packageId} {
  allow read: if isActive();

  allow create: if isAdmin()
    || (
      isEditor()
      && request.resource.data.created_by == request.auth.token.email
      && request.resource.data.package_id == packageId
      && request.resource.data.workflow_status in ['draft', 'review']
    );

  allow update: if isAdmin()
    || (
      isEditor()
      && resource.data.created_by == request.auth.token.email
      && resource.data.workflow_status in ['draft', 'review']
      && request.resource.data.created_by == resource.data.created_by
      && request.resource.data.package_id == resource.data.package_id
      && request.resource.data.workflow_status in ['draft', 'review']
    )
    || (
      isReviewer()
      && resource.data.workflow_status == 'review'
      && request.resource.data.workflow_status == 'approved'
      && request.resource.data.approved_by == request.auth.token.email
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'workflow_status',
        'approved_by',
        'approved_at',
        'updated_at'
      ])
    );

  allow delete: if isAdmin();
}

// ตัวนับเลขฉบับแบบ Transaction ป้องกันเลขซ้ำ
match /versionCounters/{contentId} {
  allow read: if isAdmin()
    || isReviewer()
    || (
      isEditor()
      && get(
        /databases/$(database)/documents/contents/$(contentId)
      ).data.created_by == request.auth.token.email
    );

  allow create: if (
      isAdmin()
      || isReviewer()
      || canEditOwnedContent(contentId)
    )
    && request.resource.data.content_id == contentId
    && request.resource.data.next_version is int
    && request.resource.data.next_version > 0
    && request.resource.data.updated_by == request.auth.token.email;

  allow update: if (
      isAdmin()
      || isReviewer()
      || canEditOwnedContent(contentId)
    )
    && request.resource.data.content_id == resource.data.content_id
    && request.resource.data.next_version is int
    && request.resource.data.next_version > resource.data.next_version
    && request.resource.data.updated_by == request.auth.token.email
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
      'next_version',
      'updated_by',
      'updated_at'
    ]);

  allow delete: if false;
}

// ประวัติฉบับแบบแก้ไขไม่ได้
match /contentVersions/{versionId} {
  allow read: if isAdmin()
    || isReviewer()
    || (
      isEditor()
      && resource.data.created_by == request.auth.token.email
    );

  allow create: if (
      isAdmin()
      || (
        isEditor()
        && canEditOwnedContent(request.resource.data.content_id)
        && request.resource.data.created_by == request.auth.token.email
      )
      || (
        isReviewer()
        && request.resource.data.action in ['baseline', 'approve']
      )
    )
    && request.resource.data.version_id == versionId
    && request.resource.data.editor_email == request.auth.token.email
    && request.resource.data.content_id is string
    && exists(
      /databases/$(database)/documents/contents/$(request.resource.data.content_id)
    )
    && request.resource.data.created_by == get(
      /databases/$(database)/documents/contents/$(request.resource.data.content_id)
    ).data.created_by
    && request.resource.data.content_type == get(
      /databases/$(database)/documents/contents/$(request.resource.data.content_id)
    ).data.content_type
    && request.resource.data.schema_version == 2
    && request.resource.data.snapshot_status == 'building'
    && request.resource.data.version_number == getAfter(
      /databases/$(database)/documents/versionCounters/$(request.resource.data.content_id)
    ).data.next_version
    && request.resource.data.snapshot.content.content_id
      == request.resource.data.content_id
    && request.resource.data.version_number is int
    && request.resource.data.version_number > 0;

  allow update: if isActive()
    && resource.data.editor_email == request.auth.token.email
    && resource.data.snapshot_status == 'building'
    && request.resource.data.snapshot_status in ['complete', 'failed']
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
      'snapshot_status',
      'completed_at',
      'failed_at'
    ]);

  allow delete: if false;

  match /{subcollection}/{itemId} {
    allow read: if isAdmin()
      || isReviewer()
      || (
        isEditor()
        && get(
          /databases/$(database)/documents/contentVersions/$(versionId)
        ).data.created_by == request.auth.token.email
      );

    allow create: if isActive()
      && subcollection in ['lessonUnits', 'answers', 'files']
      && getAfter(
        /databases/$(database)/documents/contentVersions/$(versionId)
      ).data.editor_email == request.auth.token.email
      && getAfter(
        /databases/$(database)/documents/contentVersions/$(versionId)
      ).data.snapshot_status == 'building';

    allow update, delete: if false;
  }
}

match /issueReports/{reportId} {
  allow read: if isAdmin()
    || isReviewer()
    || (
      isActive()
      && resource.data.reported_by == request.auth.token.email
    );

  allow create: if isActive()
    && request.resource.data.report_id == reportId
    && request.resource.data.reported_by == request.auth.token.email
    && request.resource.data.status == 'open';

  allow update: if (isAdmin() || isReviewer())
    && request.resource.data.report_id == resource.data.report_id
    && request.resource.data.reported_by == resource.data.reported_by;

  allow delete: if isAdmin();
}

match /knowledgeGaps/{gapId} {
  allow read: if isAdmin() || isReviewer();

  allow create: if (isAdmin() || isReviewer())
    && request.resource.data.gap_id == gapId
    && request.resource.data.gap_type in [
      'missing_search',
      'unanswered_question',
      'thin_category',
      'repeated_issue'
    ]
    && request.resource.data.status in [
      'open',
      'assigned',
      'in_progress',
      'resolved',
      'dismissed'
    ]
    && request.resource.data.priority in ['low', 'medium', 'high', 'urgent']
    && request.resource.data.created_by == request.auth.token.email
    && request.resource.data.updated_by == request.auth.token.email;

  allow update: if (isAdmin() || isReviewer())
    && request.resource.data.gap_id == resource.data.gap_id
    && request.resource.data.gap_type == resource.data.gap_type
    && request.resource.data.source_key == resource.data.source_key
    && request.resource.data.created_by == resource.data.created_by
    && request.resource.data.status in [
      'open',
      'assigned',
      'in_progress',
      'resolved',
      'dismissed'
    ]
    && request.resource.data.priority in ['low', 'medium', 'high', 'urgent']
    && request.resource.data.updated_by == request.auth.token.email;

  allow delete: if isAdmin();
}

match /usageStats/{statId} {
  allow get: if isActive()
    && (
      isAdmin()
      || isReviewer()
      || (
        statId.matches(request.auth.uid + '_.*')
        && (resource == null || resource.data.user_id == request.auth.uid)
      )
    );

  allow list: if isActive()
    && (
      isAdmin()
      || isReviewer()
      || resource.data.user_id == request.auth.uid
    );

  allow create: if isActive()
    && statId.matches(request.auth.uid + '_.*')
    && request.resource.data.user_id == request.auth.uid
    && request.resource.data.count == 1
    && request.resource.data.keys().hasOnly([
      'user_id',
      'action',
      'target_type',
      'target_id',
      'count',
      'last_used_at'
    ]);

  allow update: if isActive()
    && statId.matches(request.auth.uid + '_.*')
    && resource.data.user_id == request.auth.uid
    && request.resource.data.user_id == resource.data.user_id
    && request.resource.data.action == resource.data.action
    && request.resource.data.target_type == resource.data.target_type
    && request.resource.data.target_id == resource.data.target_id
    && request.resource.data.count == resource.data.count + 1
    && request.resource.data.diff(resource.data).affectedKeys()
      .hasOnly(['count', 'last_used_at']);

  allow delete: if isAdmin();
}

    function isSharedUsageAggregate(data) {
      return (data.action == 'select' && data.target_type == 'category')
        || (data.action == 'open' && data.target_type in ['category', 'content']);
    }

    function hasCanonicalUsageAggregateId(aggregateId, data) {
      return data.target_id is string
        && data.target_id.matches('^[^/]{1,120}$')
        && aggregateId == data.action + '_' + data.target_type + '_' + data.target_id;
    }

    function isPublicUsageAggregateId(aggregateId) {
      return aggregateId.matches('^(select_category|open_category|open_content)_[^/]{1,120}$');
    }

match /usageAggregates/{aggregateId} {
  // Search terms remain in owner-scoped usageStats; reporters retain legacy aggregate reads.
  allow get: if isActive()
    && (isAdmin() || isReviewer()
      || (resource == null && isPublicUsageAggregateId(aggregateId))
      || (resource != null
        && isSharedUsageAggregate(resource.data)
        && hasCanonicalUsageAggregateId(aggregateId, resource.data)));
  allow list: if isActive()
    && (isAdmin() || isReviewer() || isSharedUsageAggregate(resource.data));

  allow create: if isActive()
    && isSharedUsageAggregate(request.resource.data)
    && hasCanonicalUsageAggregateId(aggregateId, request.resource.data)
    && request.resource.data.count == 1
    && request.resource.data.last_used_at is timestamp
    && request.resource.data.keys().hasOnly([
      'action',
      'target_type',
      'target_id',
      'count',
      'last_used_at'
    ]);

  allow update: if isActive()
    && isSharedUsageAggregate(resource.data)
    && isSharedUsageAggregate(request.resource.data)
    && hasCanonicalUsageAggregateId(aggregateId, resource.data)
    && hasCanonicalUsageAggregateId(aggregateId, request.resource.data)
    && request.resource.data.action == resource.data.action
    && request.resource.data.target_type == resource.data.target_type
    && request.resource.data.target_id == resource.data.target_id
    && request.resource.data.count == resource.data.count + 1
    && request.resource.data.count is int
    && request.resource.data.last_used_at is timestamp
    && request.resource.data.diff(resource.data).affectedKeys()
      .hasOnly(['count', 'last_used_at']);

  allow delete: if isAdmin();
}

    // ปฏิเสธ Collection อื่นที่ไม่ได้กำหนดไว้
    match /{document=**} {
      allow read, write: if false;
    }

  }
}
